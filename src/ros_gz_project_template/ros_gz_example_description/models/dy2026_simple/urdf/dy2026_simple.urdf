  </joint>
  <!-- Increase friction to prevent main chasis from rocking -->
  <joint name="rocker_left_joint" type="continuous">
    <origin xyz="3.06151e-05 0.312853 0.103048" rpy="-1.52649e-11 1.57079 -1.5708"/>
    <parent link="base_link"/>
