    <!-- =========================== CONTROLLER =========================== -->
    <!-- Each swerve module needs its own steering joint (yaw) and drive/wheel
         joint (spin) exposed to the plugin. Adjust plugin name/params to match
         the actual swerve controller you're using (this schema mirrors common
         gz-sim swerve-drive plugin conventions; substitute your real plugin
         filename/typename if different). -->
    <plugin
      filename="SwerveSystem"
      name="ros_gz_example_gazebo::SwerveSystem">

      <front_left_steering_joint>front_left_steering_joint</front_left_steering_joint>
      <front_left_wheel_joint>front_left_wheel_joint</front_left_wheel_joint>

      <front_right_steering_joint>front_right_steering_joint</front_right_steering_joint>
      <front_right_wheel_joint>front_right_wheel_joint</front_right_wheel_joint>

      <back_left_steering_joint>back_left_steering_joint</back_left_steering_joint>
      <back_left_wheel_joint>back_left_wheel_joint</back_left_wheel_joint>

      <back_right_steering_joint>back_right_steering_joint</back_right_steering_joint>
      <back_right_wheel_joint>back_right_wheel_joint</back_right_wheel_joint>

      <!-- geometry: distance between front/back axles and left/right wheels -->
      <wheel_base>1.41142</wheel_base>
      <track_width>1.250058</track_width>
      <wheel_radius>0.3</wheel_radius>

      <!-- friction / traction model params (consumed by controller for
           slip-aware velocity limiting, not just the ODE surface above) -->
      <wheel_friction_coefficient>1.2</wheel_friction_coefficient>
      <max_wheel_torque>20</max_wheel_torque>

      <odom_publish_frequency>50</odom_publish_frequency>

      <max_linear_acceleration>1</max_linear_acceleration>
      <min_linear_acceleration>-1</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>

      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1</max_angular_velocity>
      <min_angular_velocity>-1</min_angular_velocity>

      <!-- max steering rate of each module, rad/s -->
      <max_steering_velocity>5</max_steering_velocity>
    </plugin>

  </model>
</sdf>